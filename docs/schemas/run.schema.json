{
  "$defs": {
    "CommandSpec": {
      "properties": {
        "argv": {
          "items": {
            "type": "string"
          },
          "title": "Argv",
          "type": "array"
        },
        "cwd": {
          "title": "Cwd",
          "type": "string"
        },
        "cwd_is_relative": {
          "default": false,
          "title": "Cwd Is Relative",
          "type": "boolean"
        },
        "raw": {
          "title": "Raw",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "shell_note": {
          "default": "started without a shell; argv list passed verbatim",
          "title": "Shell Note",
          "type": "string"
        }
      },
      "required": [
        "raw",
        "argv",
        "cwd"
      ],
      "title": "CommandSpec",
      "type": "object"
    },
    "ExitMeaning": {
      "enum": [
        "exited",
        "signaled",
        "killed",
        "not_started",
        "unknown"
      ],
      "title": "ExitMeaning",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "running",
        "succeeded",
        "failed",
        "interrupted",
        "start_failed"
      ],
      "title": "RunStatus",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One experiment run.\n\n``exit_code_raw`` keeps what the OS reported, ``exit_code`` the normalized value the\nuser's shell would have seen. Windows reports ``0xC000013A`` for Ctrl+C where POSIX\nreports 130; both must be visible or the \"exit code is preserved\" claim is false.",
  "properties": {
    "command": {
      "$ref": "#/$defs/CommandSpec"
    },
    "duration_seconds": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Seconds"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "ended_environment": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended Environment"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "exit_code_raw": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code Raw"
    },
    "exit_meaning": {
      "$ref": "#/$defs/ExitMeaning",
      "default": "unknown"
    },
    "forced_kill": {
      "default": false,
      "title": "Forced Kill",
      "type": "boolean"
    },
    "interrupted": {
      "default": false,
      "title": "Interrupted",
      "type": "boolean"
    },
    "killed_by_labbox": {
      "default": false,
      "title": "Killed By Labbox",
      "type": "boolean"
    },
    "labbox_version": {
      "default": "",
      "title": "Labbox Version",
      "type": "string"
    },
    "labbox_version_pin": {
      "default": "",
      "title": "Labbox Version Pin",
      "type": "string"
    },
    "links": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Links",
      "type": "object"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "project": {
      "title": "Project",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Schema Note"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus",
      "default": "running"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "run_id",
    "name",
    "project",
    "started_at",
    "command"
  ],
  "title": "RunRecord",
  "type": "object",
  "x-labbox-document": "run.json"
}
