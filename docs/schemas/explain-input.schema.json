{
  "$defs": {
    "Diagnostic": {
      "properties": {
        "code": {
          "default": "",
          "title": "Code",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "id": {
          "default": "",
          "title": "Id",
          "type": "string"
        },
        "message": {
          "default": "",
          "title": "Message",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "info"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suggestion"
        }
      },
      "title": "Diagnostic",
      "type": "object"
    },
    "DiffFact": {
      "properties": {
        "category": {
          "default": "other",
          "title": "Category",
          "type": "string"
        },
        "comparable": {
          "default": true,
          "title": "Comparable",
          "type": "boolean"
        },
        "confidence": {
          "default": "high",
          "title": "Confidence",
          "type": "string"
        },
        "delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta"
        },
        "delta_repr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta Repr"
        },
        "id": {
          "default": "",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/DiffKind",
          "default": "changed"
        },
        "left": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Left"
        },
        "left_repr": {
          "default": "",
          "title": "Left Repr",
          "type": "string"
        },
        "path": {
          "default": "",
          "title": "Path",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "right": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Right"
        },
        "right_repr": {
          "default": "",
          "title": "Right Repr",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity",
          "default": "info"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "unknown_side": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unknown Side"
        }
      },
      "title": "DiffFact",
      "type": "object"
    },
    "DiffKind": {
      "enum": [
        "changed",
        "added",
        "removed",
        "numeric_delta",
        "metric_delta",
        "unknown",
        "incomparable",
        "equal"
      ],
      "title": "DiffKind",
      "type": "string"
    },
    "PrivacyLevel": {
      "enum": [
        "local_only",
        "structured_only",
        "logs_allowed"
      ],
      "title": "PrivacyLevel",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "critical",
        "high",
        "warning",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    },
    "TaskType": {
      "enum": [
        "single_run",
        "compare"
      ],
      "title": "TaskType",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "allowed_fact_ids": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Fact Ids",
      "type": "array"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/DiffFact"
      },
      "title": "Facts",
      "type": "array"
    },
    "language": {
      "default": "zh-CN",
      "title": "Language",
      "type": "string"
    },
    "log_excerpt": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Log Excerpt"
    },
    "max_log_excerpt_chars": {
      "default": 4000,
      "title": "Max Log Excerpt Chars",
      "type": "integer"
    },
    "metric_names": {
      "items": {
        "type": "string"
      },
      "title": "Metric Names",
      "type": "array"
    },
    "metrics": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "null"
          }
        ]
      },
      "title": "Metrics",
      "type": "object"
    },
    "missing_fields": {
      "items": {
        "type": "string"
      },
      "title": "Missing Fields",
      "type": "array"
    },
    "privacy": {
      "$ref": "#/$defs/PrivacyLevel",
      "default": "structured_only"
    },
    "run_ids": {
      "items": {
        "type": "string"
      },
      "title": "Run Ids",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task": {
      "$ref": "#/$defs/TaskType",
      "default": "single_run"
    }
  },
  "title": "ExplainContext",
  "type": "object",
  "x-labbox-document": "explain-input.json"
}
