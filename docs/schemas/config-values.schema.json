{
  "$defs": {
    "Confidence": {
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "HyperValue": {
      "properties": {
        "ambiguous": {
          "default": false,
          "title": "Ambiguous",
          "type": "boolean"
        },
        "confidence": {
          "$ref": "#/$defs/Confidence",
          "default": "high"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "raw_type": {
          "default": "",
          "title": "Raw Type",
          "type": "string"
        },
        "schema_version": {
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "source_kinds": {
          "items": {
            "$ref": "#/$defs/ValueSource"
          },
          "title": "Source Kinds",
          "type": "array"
        },
        "sources": {
          "items": {
            "type": "string"
          },
          "title": "Sources",
          "type": "array"
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "value_repr": {
          "default": "",
          "title": "Value Repr",
          "type": "string"
        }
      },
      "required": [
        "path"
      ],
      "title": "HyperValue",
      "type": "object"
    },
    "ValueSource": {
      "enum": [
        "command.argv",
        "config.file",
        "env",
        "code.default",
        "user.declared",
        "log"
      ],
      "title": "ValueSource",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "files_read": {
      "items": {
        "type": "string"
      },
      "title": "Files Read",
      "type": "array"
    },
    "files_skipped": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Files Skipped",
      "type": "array"
    },
    "flatten_depth_limit": {
      "default": 6,
      "title": "Flatten Depth Limit",
      "type": "integer"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "values": {
      "items": {
        "$ref": "#/$defs/HyperValue"
      },
      "title": "Values",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "title": "HyperparamSet",
  "type": "object",
  "x-labbox-document": "config-values.json"
}
